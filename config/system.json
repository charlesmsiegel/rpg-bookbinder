        "sizes": {
          "portrait": [512, 512],
          "landscape": [768, 512],
          "column": [384, 768],
          "full_page": [512, 768]
        }
      },
      "ideogram-v4": {
        "backend": "comfyui",
        "endpoint": "http://127.0.0.1:8188",
        "rules_file": "styles/art/ideogram-v4.md",
        "workflow_file": "styles/art/example.workflow.json",
        "style_prefix": "",
        "negative_prompt": ""
      }
    }
  },
  "layout": {
    "style_file": "styles/layout/default.md",
