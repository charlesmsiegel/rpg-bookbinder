      {
        "term": "—",
        "max_per_10k_words": 20
      }
    ]
  },
  "terminology": {
    "gamemaster": "Gamemaster",
    "player_character": "Player Character",
    "supplement": "supplement"
  },
  "citations": {
    "book_map": {},
    "patterns": [
      "(?P<book>[A-Z][\\w :']+?),?\\s*p\\.\\s*(?P<page>\\d+)"
    ],
    "bibliography": {}
  },
  "mechanics": {
    "xp_costs": {},
