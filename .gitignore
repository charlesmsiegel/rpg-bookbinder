__pycache__/
*.pyc
node_modules/
.worktrees/
.obsidian/
.conda/
.vscode/
.superpowers/
generated_images/
# Only direct children are excluded, so a whole directory can be re-included
# below. `references/**` would exclude references/prism itself, and git cannot
# re-include a file whose parent directory is excluded.
references/*
!references/README.md
# PRISM's canon is our own original content, not third-party source material.
!references/prism/
.claude/settings.local.json

# Bookbinder writes timestamped state backups on every update
projects/*/state/*.backup_*.json

# ComfyOrg API key for tools/generate_ideogram.py — never commit
.comfy_api_key

# Compiled exports are build artifacts, rebuilt by /compile from the sources
projects/*/output/*.docx
projects/*/output/*.epub
projects/*/output/*.pdf
projects/*/output/art/
projects/*/output/*.export.md
